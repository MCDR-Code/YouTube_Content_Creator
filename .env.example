# Copy this file to .env and fill in real values. .env is never committed to git.
# Each agent has its own Prune key (they start with prune_), created in the Prune
# dashboard under Connect > API Keys, each with its own daily spend cap.
# In mock mode these can stay empty: the system uses fake keys and a fake Prune server.

PRUNE_KEY_DIRECTOR=
PRUNE_KEY_TREND_SCOUT=
PRUNE_KEY_AUDIENCE=
PRUNE_KEY_MONETIZATION=
PRUNE_KEY_SCRIPTWRITER=
PRUNE_KEY_FACT_CHECKER=
PRUNE_KEY_VISUAL=
PRUNE_KEY_PACKAGING=
PRUNE_KEY_SHORTS=
PRUNE_KEY_ANALYTICS=

# Swarms sends usage telemetry (including run text) to telemetry.swarms.world by default.
# We turn it off. The code also forces this off before Swarms is imported.
SWARMS_TELEMETRY_ON=false

# Web app login (required). At least 10 characters. Anyone with the Cloudflare link sees the
# login page, so use a strong password that you don't use anywhere else.
YCC_ADMIN_PASSWORD=

# Optional: a long random string so logins survive an app restart. If empty, one is made at each start.
YCC_SECRET_KEY=

# Never set an OpenAI key here. Every model call must go through Prune.
